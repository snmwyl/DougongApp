<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8E0D0">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <!-- 模型选择按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="8dp">

        <Button
            android:id="@+id/btn_ludou"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="栌斗"
            android:backgroundTint="#B5282C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_huagong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="华拱"
            android:backgroundTint="#C8A45C"
            android:textColor="#1A1A1A" />

        <Button
            android:id="@+id/btn_ang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="昂"
            android:backgroundTint="#E8D5B5"
            android:textColor="#1A1A1A" />

    </LinearLayout>

    <!-- 视角控制按钮（全部改为蓝色） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_front"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="正面"
            android:backgroundTint="#4A6A8A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_side"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="侧面"
            android:backgroundTint="#4A6A8A"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_upview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="仰视"
            android:backgroundTint="#4A6A8A"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>